# Linq (https://dashboard.linqapp.com/sandbox-signup — free sandbox for Hack the North hackers)
LINQ_API_KEY=
LINQ_BASE_URL=https://api.linqapp.com/api/partner/v3
# LINQ_FROM=+1555...            # your provisioned Linq number; omit to let Linq choose
# LINQ_ALLOWED_SENDERS=+1555...,+1555...   # empty = anyone who texts the number

# HMAC signing secret, returned ONCE in the `subscribe` response as `signing_secret` (whsec_...).
# This is the real webhook authentication: it proves Linq sent these exact bytes. Set it.
LINQ_WEBHOOK_SECRET=

# Shared secret for the webhook URL (?token=...), the fallback for before you have the signing
# secret above. Generate: python3 -c "import secrets;print(secrets.token_urlsafe(32))"
LINQ_WEBHOOK_TOKEN=

# Where the fold paths and the trained model live (both default to inside this repo)
# CUBOT_HANDOFF_DIR=../cubot-v2/handoff
# CUBOT_INTENT_HEAD=data/intent_head.npz
# CUBOT_INTENT_CORPUS=data/utterances.jsonl

# Server
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_EXECUTOR=hardware      # dryrun | spool | viewer | mujoco | hardware | none
BRIDGE_AUTO_REPLY=true
BRIDGE_REACT_ON_RECEIVE=true  # 👍 when we can fold; 🤔 when we cannot
BRIDGE_RATE_LIMIT_PER_MINUTE=6

# Live STS3215 bus (Downloads/cubot rc + sts3215 — not vendored)
# CUBOT_HW_ROOT=/Users/jerryli/Downloads/cubot
# CUBOT_SERIAL_PORT=           # empty = autodetect FE-URT-1
# CUBOT_GEAR=4
# CUBOT_POWER=0                # 0=gentle 1=normal 2=strong 3=max
# CUBOT_MUJOCO_MIRROR=true     # with hardware: also open MuJoCo while the bus folds

# OpenAI — only consulted when MiniLM cannot map the text to a playable shape
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK=true
